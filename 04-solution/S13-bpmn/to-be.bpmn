<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="bpmn_defs" targetNamespace="http://battery2030.example/bpmn">
  <bpmn:collaboration id="collab"><bpmn:participant id="pool" name="Quy trình To-Be: thu hồi, đánh giá, điều phối, báo cáo EPR (S13)" processRef="to_be"/></bpmn:collaboration>
  <bpmn:process id="to_be" isExecutable="false">
    <bpmn:laneSet id="bpmn_laneset">
      <bpmn:lane id="lane0" name="Đại lý / trạm đổi pin">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane1" name="Kho vận VELIX">
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane2" name="Trung tâm kiểm định VELIX">
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane3" name="Nền tảng Battery 2030">
        <bpmn:flowNodeRef>y1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>y2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>y3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>y4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane4" name="Đơn vị tái chế / đời thứ hai">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane5" name="Tuân thủ VELIX">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>y5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Khách mang pin đến">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a1" name="Quét mã pin hoặc cấp mã tạm hãng khác [BR-06]">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a2" name="Checklist an toàn; pin nguy hiểm → cách ly [BR-07]">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a4" name="Lưu phiếu, phí 0 đ (ngoại tuyến được) [BR-30]">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="y1" name="Cập nhật tồn kho, kiểm ngưỡng gom lô [BR-08]">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="k1" name="Lập lô gom GL-, vận chuyển">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c1" name="Cân nhận tại trung tâm, kiểm chênh lệch [BR-16]">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Pin Li không nguy hiểm?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="y2" name="Ước lượng SoH + khoảng tin cậy [BR-10]">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="Đủ tin cậy?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="c2" name="Đo tay SoH">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g5" name="">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="y3" name="Đề xuất điều phối [BR-11, BR-12, BR-29]">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g6" name="Hướng?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="k3" name="Lập lô CT-, kiểm giấy phép [BR-15]">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c3" name="Phê duyệt Đời thứ hai (người khác) [BR-13]">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="k2" name="Bàn giao kèm hợp đồng, tạo hồ sơ mới [BR-25]">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Pin vào đời thứ hai">
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="r1" name="Cân nhận, ghi chênh lệch [BR-16]">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="r2" name="Xác nhận đã tái chế theo quy cách [BR-17]">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="y4" name="Đóng hồ sơ pin, cộng kết quả tái chế [BR-26]">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Pin đã tái chế">
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2" name="Trước 01/4 hằng năm">
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Chọn hình thức và cách thức [BR-20]">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="y5" name="Tính V, R×V, kết quả, bảo lưu, F [BR-04, 18, 19]">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t2" name="Xuất hồ sơ, nộp Hệ thống EPR quốc gia [FR-24]">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g7" name="Đóng góp tài chính?">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Nộp tiền vào Quỹ BVMT trước 20/4">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e3" name="Hoàn thành nghĩa vụ năm">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:incoming>f29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s1" targetRef="a1" name=""/>
    <bpmn:sequenceFlow id="f1" sourceRef="a1" targetRef="a2" name=""/>
